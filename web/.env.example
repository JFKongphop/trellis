# Trellis web: copy to .env.local and fill in. Never commit real values.

# ── LLM: NEAR AI Cloud (required for chat) ──────────────────────────────────
# Create a key at https://cloud.near.ai. Without it /api/chat returns a clear
# 500 error and every other page still works.
NEARAI_API_KEY=
# Optional: NEAR Intents 1Click partner JWT (partners.near-intents.org). Without it quotes work but carry an extra 0.25% fee.
ONECLICK_API_KEY=
# Optional: default chat model (must support tool calling). The model picker
# in the chat input offers the ids listed in src/lib/ai/pricing.ts.
NEARAI_MODEL=z-ai/glm-5.3-flash

# ── NEAR network ────────────────────────────────────────────────────────────
# Trellis targets mainnet (Rhea Lending, Ref and Intents have no usable testnet).
NEXT_PUBLIC_NEAR_NETWORK=mainnet
# Optional: comma-separated public RPC list (tried in order). Default:
# https://free.rpc.fastnear.com,https://near.drpc.org,https://rpc.mainnet.near.org
NEXT_PUBLIC_NEAR_RPC_URLS=
# Optional, server-only: FastNEAR API key for higher RPC / REST rate limits.
# The free tier rate-limits quickly under load (HTTP 429).
FASTNEAR_API_KEY=

# ── Trellis contracts ───────────────────────────────────────────────────────
# Vault factory (create_vault / get_vault / get_min_deposit) and the agent
# account vaults authorize with set_agent. Public: used by the browser.
NEXT_PUBLIC_TRELLIS_FACTORY=trellis.near
NEXT_PUBLIC_TRELLIS_AGENT=agent.trellis.near

# ── Worker (server-only; never exposed to the browser) ──────────────────────
# The Trellis worker runs owner-approved vault plans and watches vault health.
# Without these, vault approvals return a clear 503 and wallet mode still works.
WORKER_URL=http://localhost:8787
WORKER_API_TOKEN=

# ── Sign-in sessions (NEP-413) ──────────────────────────────────────────────
# HMAC secret for the session cookie and vault-plan approval tokens (32+ chars).
# Falls back to API_SIGNING_SECRET; in dev a random per-process secret is used.
AUTH_SECRET=

# ── API protection (src/proxy.ts) ───────────────────────────────────────────
# HMAC secret for the session cookie + per-request signatures on /api/*.
# Required in production (32+ chars, e.g. `openssl rand -hex 32`). In dev,
# when unset, /api protection is disabled with a console warning.
API_SIGNING_SECRET=
# Optional: extra hostnames allowed to call /api/* (comma-separated).
ALLOWED_ORIGINS=
# Optional: apex domain for the session cookies (e.g. trellis.app).
COOKIE_DOMAIN=
