{
  "name": "trellis-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Trellis background agent: watches vault health, auto-deleverages, and runs owner-approved plans inside the vault's rules",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "provision": "tsx src/scripts/provision-key.ts"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "near-api-js": "7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
